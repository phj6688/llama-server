# llama-server .env
# Copy to .env and adjust. chmod 600.

# Model (required)
LLAMA_MODEL_PATH=/models/medgemma-27b-text-it-Q4_K_M.gguf
LLAMA_MODEL_ALIAS=medgemma-27b
LLAMA_MODELS_DIR=/home/peyman/projects/medchat/models

# Inference
LLAMA_CONTEXT=8192
LLAMA_GPU_LAYERS=999
LLAMA_KV_TYPE_K=q8_0
LLAMA_KV_TYPE_V=q8_0

# Resource limits
LLAMA_MEM_LIMIT=18g
LLAMA_MIN_FREE_GB=4
LLAMA_MAX_SWAP_GB=10

# ROCm (AMD iGPU)
HSA_OVERRIDE_GFX_VERSION=11.0.0

# Build
LLAMA_CPP_TAG=server-rocm-b9070
