# llama-server .env
# Copy to .env and adjust. chmod 600.

# Model (required)
LLAMA_MODEL_PATH=/models/medgemma-4b-it-Q4_K_M.gguf
LLAMA_MODEL_ALIAS=medgemma-4b
LLAMA_MODELS_DIR=/home/peyman/projects/medchat/models

# Inference
LLAMA_CONTEXT=8192
LLAMA_GPU_LAYERS=999
LLAMA_KV_TYPE_K=q8_0
LLAMA_KV_TYPE_V=q8_0

# Resource limits
LLAMA_MEM_LIMIT=18g
LLAMA_MIN_FREE_GB=4
LLAMA_MAX_SWAP_GB=10

# Tool/function calling (leave empty to disable)
LLAMA_CHAT_TEMPLATE_FILE=/app/templates/gemma3-tools.jinja

# Keep everything the model writes in the content field instead of running
# llama.cpp's strict template parser. Set it to false only when the resident
# model emits well-formed tool calls; a fenced call makes the strict parser
# throw, and the client loses the whole turn. See entrypoint.sh.
LLAMA_SKIP_CHAT_PARSING=true

# ROCm (AMD iGPU)
HSA_OVERRIDE_GFX_VERSION=11.0.0

# Build
LLAMA_CPP_TAG=server-rocm-b9070
